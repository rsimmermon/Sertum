{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "import",
    "typescript"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "ignorePatterns": [
    "**/.vite/**",
    "**/out/**",
    "**/.temp/**",
    "**/node_modules/**"
  ],
  "rules": {
    "no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^_",
        "caughtErrors": "none"
      }
    ],
    "no-await-in-loop": "off",
    "import/no-unassigned-import": "off",
    "no-underscore-dangle": "off"
  }
}
