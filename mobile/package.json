{
  "name": "sertum-mobile",
  "version": "0.0.1",
  "private": true,
  "description": "Sertum's phone client. Always a client of a sertumd on a PC; never hosts sessions.",
  "type": "module",
  "scripts": {
    "icons": "node scripts/make-icons.mjs",
    "build": "vite build",
    "sync": "vite build && cap sync android",
    "apk": "npm run sync && cd android && gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.20.5",
    "bonjour-service": "^1.3.0",
    "selfsigned": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^5.4.21",
    "ws": "^8.18.0"
  },
  "allowScripts": {
    "esbuild": true
  }
}
